# Local backend defaults. Copy to backend/.env (ignored) for local runs.
# Never put real credentials in this template.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://127.0.0.1:5174
PROCESSING_JOB_STORE_ENABLED=false
# Opt-in only after a compatible client and authorized worker dispatch exist.
PRESCRIPTION_AUTO_SUBMIT_ENABLED=false
# Phase 1B review APIs remain unavailable until reviewed persistence is deployed.
MEDDECODE_PRESCRIPTION_REVIEW_V3_ENABLED=false

# Safe default for unverified environments. For the verified local development
# project set these in backend/.env: MEDICINE_CATALOGUE_READ_ENABLED=true,
# MEDICINE_CATALOGUE_DEFAULT_SOURCE=official_catalogue and
# PROCESSING_JOB_STORE_ENABLED=true. Keep PROCESSING_WORKER_ENABLED=false.
MEDICINE_CATALOGUE_READ_ENABLED=false
# Switch only after deployment verification; requests may explicitly use source=legacy.
MEDICINE_CATALOGUE_DEFAULT_SOURCE=legacy

# Required only for Supabase-backed operations. Keep the secret key server-side.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Required only for prescription object storage. Prefer a local AWS profile or
# another approved credential provider instead of putting access keys in a file.
AWS_REGION=
AWS_S3_BUCKET=
# Optional AWS SDK environment credentials; leave blank unless explicitly needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PRESCRIPTION_MAX_FILE_SIZE_BYTES=10485760
PRESCRIPTION_UPLOAD_TIMEOUT_MS=30000

# Dedicated worker is a separate process; leave disabled until worker RPCs,
# restricted login, verified certificate, and catalogue are provisioned.
PROCESSING_WORKER_ENABLED=false
# Development worker execution is fail-closed unless scoped RPCs have been independently deployed and authorized.
WORKER_RPC_MODE=scoped
# Private processing service. Use a dedicated secret from a protected environment.
PYTHON_INTELLIGENCE_URL=http://127.0.0.1:8000
MEDDECODE_INTERNAL_TOKEN=
# Optional separate restricted database login for /ready; never use a service-role credential.
BACKEND_READINESS_DATABASE_URL=
BACKEND_READINESS_DATABASE_CA_FILE=
# Requires the separately reviewed automatic issuer migration and dedicated login.
WORKER_AUTOMATIC_AUTHORIZATION_ENABLED=false
PROCESSING_WORKER_INSTANCE_ID=
WORKER_DATABASE_URL=
WORKER_DATABASE_CA_FILE=
WORKER_PYTHON_EXECUTABLE=
WORKER_INTELLIGENCE_DIRECTORY=
WORKER_EASYOCR_MODEL_DIRECTORY=
WORKER_LOCAL_OFFICIAL_CATALOGUE=false
# Python catalogue configuration. Hosted mode requires a separately restricted
# read-only identity, verify-full TLS, a CA file and a password or passfile.
MEDDECODE_CATALOGUE_ENV=
MEDDECODE_CATALOGUE_HOST=
MEDDECODE_CATALOGUE_PORT=
MEDDECODE_CATALOGUE_DATABASE=
MEDDECODE_CATALOGUE_USER=
MEDDECODE_CATALOGUE_SSLMODE=
MEDDECODE_CATALOGUE_SSLROOTCERT=
MEDDECODE_CATALOGUE_PASSFILE=
MEDDECODE_CATALOGUE_PASSWORD=
MEDDECODE_CATALOGUE_CONNECT_TIMEOUT_SECONDS=

# Disabled by default. These local paths are needed only for the fictional
# development fixture; never point this endpoint at real prescription files.
DEVELOPMENT_FIXTURE_INTELLIGENCE_ENABLED=false
DEVELOPMENT_FIXTURE_PYTHON_EXECUTABLE=
DEVELOPMENT_FIXTURE_INTELLIGENCE_DIRECTORY=
DEVELOPMENT_FIXTURE_PDF_PATH=
