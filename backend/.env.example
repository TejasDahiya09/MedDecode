# Local backend defaults. Copy to backend/.env (ignored) for local runs.
# Never put real credentials in this template.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://127.0.0.1:5174
PROCESSING_JOB_STORE_ENABLED=false

# Required only for Supabase-backed operations. Keep the secret key server-side.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Required only for prescription object storage. Prefer a local AWS profile or
# another approved credential provider instead of putting access keys in a file.
AWS_REGION=
AWS_S3_BUCKET=
# Optional AWS SDK environment credentials; leave blank unless explicitly needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PRESCRIPTION_MAX_FILE_SIZE_BYTES=10485760
PRESCRIPTION_UPLOAD_TIMEOUT_MS=30000

# Disabled by default. These local paths are needed only for the fictional
# development fixture; never point this endpoint at real prescription files.
DEVELOPMENT_FIXTURE_INTELLIGENCE_ENABLED=false
DEVELOPMENT_FIXTURE_PYTHON_EXECUTABLE=
DEVELOPMENT_FIXTURE_INTELLIGENCE_DIRECTORY=
DEVELOPMENT_FIXTURE_PDF_PATH=
