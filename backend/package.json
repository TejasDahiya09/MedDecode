{
  "name": "meddecode-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MedDecode backend application service",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "tsx --test tests/*.test.ts",
    "smoke:auth": "tsx scripts/auth-smoke.ts",
    "smoke:profile-write": "tsx scripts/profile-write-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@supabase/supabase-js": "^2.117.1",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
