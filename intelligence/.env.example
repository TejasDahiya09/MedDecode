# Service-only settings. Copy values privately; never commit populated credentials.
MEDDECODE_INTERNAL_TOKEN=
MEDDECODE_EASYOCR_MODEL_DIRECTORY=
# Disabled by default. When enabled, both explicit local PaddleOCR model paths
# are required; no runtime model download or cloud OCR fallback is permitted.
MEDDECODE_ADAPTIVE_OCR_ENABLED=false
MEDDECODE_TROCR_ENABLED=false
# Required only when both adaptive OCR and TrOCR are explicitly enabled.
MEDDECODE_TROCR_PYTHON=
MEDDECODE_TROCR_MODEL_DIRECTORY=
MEDDECODE_TROCR_TIMEOUT_SECONDS=20
MEDDECODE_PADDLEOCR_DETECTION_MODEL_DIRECTORY=
MEDDECODE_PADDLEOCR_RECOGNITION_MODEL_DIRECTORY=

# Conservative execution-boundary defaults applied before OCR.
MEDDECODE_INTELLIGENCE_MAX_DOCUMENT_BYTES=10485760
MEDDECODE_INTELLIGENCE_MAX_PDF_PAGES=10
MEDDECODE_INTELLIGENCE_MAX_IMAGE_WIDTH=10000
MEDDECODE_INTELLIGENCE_MAX_IMAGE_HEIGHT=10000
MEDDECODE_INTELLIGENCE_MAX_RENDERED_PIXELS_PER_PAGE=25000000
MEDDECODE_INTELLIGENCE_MAX_AGGREGATE_RENDERED_PIXELS=100000000
MEDDECODE_INTELLIGENCE_TRANSFER_TIMEOUT_SECONDS=15
MEDDECODE_INTELLIGENCE_PROCESS_TIMEOUT_SECONDS=120
MEDDECODE_INTELLIGENCE_MAX_RESPONSE_BYTES=1048576
MEDDECODE_INTELLIGENCE_MAX_CHILD_RSS_BYTES=2147483648

# Existing dedicated, read-only official catalogue connection settings.
MEDDECODE_CATALOGUE_ENV=hosted
MEDDECODE_CATALOGUE_HOST=
MEDDECODE_CATALOGUE_PORT=5432
MEDDECODE_CATALOGUE_DATABASE=postgres
MEDDECODE_CATALOGUE_USER=meddecode_catalogue_python_reader
MEDDECODE_CATALOGUE_SSLMODE=verify-full
MEDDECODE_CATALOGUE_SSLROOTCERT=
MEDDECODE_CATALOGUE_PASSFILE=
MEDDECODE_DOCUMENT_PREPROCESSING_ENABLED=false
