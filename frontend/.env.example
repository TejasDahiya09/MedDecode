# Set only after the application backend's browser API contract is agreed.
# Public configuration only. Never add Supabase service-role or AWS credentials.
# Development transport uses the Vite proxy. A deployed build must use its real HTTPS API origin.
# Production requires an explicit deployed HTTP(S) API base; no preview proxy exists.
VITE_API_BASE_URL=/backend

# Browser-safe Supabase configuration only. Never use a service-role or sb_secret_ key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
