# Vite development proxy forwards relative /api/* to the local backend on port 3000.
VITE_API_BASE_URL=/

# Public browser configuration only. Never put a secret/service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Architecture V3 review UI remains disabled until both reviewed database
# migrations and the compatible backend release are independently verified.
VITE_PRESCRIPTION_REVIEW_ENABLED=false

# Keep both false until the backend rollout is explicitly approved. The backend
# readiness flag is a deployment assertion: set it true only when
# PRESCRIPTION_AUTO_SUBMIT_ENABLED and PROCESSING_JOB_STORE_ENABLED are true.
VITE_PRESCRIPTION_AUTO_SUBMIT_ENABLED=false
VITE_PRESCRIPTION_AUTO_SUBMIT_BACKEND_ENABLED=false
